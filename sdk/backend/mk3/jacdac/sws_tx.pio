; SWS Transmit
; 
; Used for JACDAC capability TX. The pio handles only the actual transmit, CPU handles the rest of the protocol. The sideset pin is used for debugging purposes only, useful for checking timing by allowing sync with a scope.
;
; Code adapted from https://github.com/raspberrypi/pico-examples/blob/master/pio/uart_tx/uart_tx.pio


.program sws_tx
.side_set 1 opt

    pull       side 1 [7]  ; Assert stop bit, or stall with line in idle state
    set x, 7   side 0 [7]  ; Preload bit counter, assert start bit for 8 clocks
bitloop:                   ; This loop will run 8 times (8n1 UART)
    out pins, 1            ; Shift 1 bit from OSR to the first OUT pin
    jmp x-- bitloop   [6]  ; Each loop iteration is 8 cycles.


%c-sdk {

inline void sws_tx_program_init(PIO pio, uint sm, uint offset, uint txPin) {
    // tell pio to initially drive the pin high
    pio_sm_set_pins_with_mask(pio, sm, 1 << txPin, 1 << txPin);
    pio_sm_set_pindirs_with_mask(pio, sm, 1 << txPin, 1 << txPin);
    pio_gpio_init(pio, txPin);

    // claim the resources required for the continuous mode
    // pio_sm_set_consecutive_pindirs(pio, sm, txPin, 1, true);
    pio_sm_config c = sws_tx_program_get_default_config(offset);
    sm_config_set_out_shift(&c, true, false, 8);
    sm_config_set_out_pins(&c, txPin, 1);
    // sideset pin is the same as output pin (for stop bit)
    sm_config_set_sideset_pins(&c, txPin);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    pio_sm_init(pio, sm, offset, &c);
}


%}