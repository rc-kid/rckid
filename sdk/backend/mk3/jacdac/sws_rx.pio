; SWS Receive
; 
; Used for JACDAC capability RX. The pio handles only the actual receive, CPU handles the rest of the protocol. The sideset pin is used for debugging purposes only, useful for checking timing by allowing sync with a scope.
;
; Code adapted from https://github.com/lancaster-university/codal-rp2040/blob/master/inc/jacdac.pio

.program sws_rx
.side_set 1 opt

start:
  wait 0 pin 0                 ; Stall until start bit is asserted
  set x, 7          side 0 [7] ; Preload bit counter, then delay until halfway through
  nop                      [1]

bitloop:                       ; the first data bit (12 cycles incl wait, set).
  in pins, 1        side 1     ; Shift data bit into ISR
  nop               side 0
  jmp x-- bitloop          [5] ; Loop 8 times, each loop iteration is 8 cycles
  jmp pin good_stop side 1     ; Check stop bit (should be high)
  irq set 0         side 0     ; Either a framing error or a break. Set a sticky flag,
  wait 1 pin 0                 ; and wait for line to return to idle state.
  jmp start         side 1     ; Don't push data if we didn't see good framing.

good_stop:                     ; No delay before returning to start; a little slack is
  nop                          ; important in case the TX clock is slightly too fast.

%c-sdk {

inline void sws_rx_program_init(PIO pio, uint sm, uint offset, uint rxPin, uint sidePin = 0xffff) {
    // claim the resources required for the continuous mode
    pio_gpio_init(pio, rxPin);
    pio_sm_set_consecutive_pindirs(pio, sm, rxPin, 1, false);
    pio_sm_config c = sws_rx_program_get_default_config(offset);
    sm_config_set_in_shift(&c, true, true, 8);
    sm_config_set_in_pins(&c, rxPin);
    sm_config_set_jmp_pin(&c, rxPin);
    if (sidePin != 0xffff) {
        pio_gpio_init(pio, sidePin);
        pio_sm_set_consecutive_pindirs(pio, sm, sidePin, 1, true);
        sm_config_set_sideset_pins(&c, sidePin);
    }
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    pio_sm_init(pio, sm, offset, &c);
}

%}